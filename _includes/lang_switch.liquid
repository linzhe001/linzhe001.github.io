<div class="lang-switch" role="group" aria-label="Language / 语言">
  <button type="button" class="lang-btn" data-lang="en">English</button>
  <button type="button" class="lang-btn" data-lang="zh">中文</button>
</div>
<style>
  .lang-switch {
    display: flex;
    justify-content: flex-end;
    margin: 0 0 1.25rem;
  }
  .lang-btn {
    font-size: 0.85rem;
    line-height: 1;
    padding: 0.4rem 1rem;
    border: 1px solid rgba(128, 128, 128, 0.45);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .lang-btn + .lang-btn {
    border-left: 0;
  }
  .lang-btn:first-child {
    border-radius: 4px 0 0 4px;
  }
  .lang-btn:last-child {
    border-radius: 0 4px 4px 0;
  }
  .lang-btn.active {
    background: var(--global-theme-color, #25638a);
    border-color: var(--global-theme-color, #25638a);
    color: #fff;
  }
  .post .post-header .post-title,
  .post .post-header .post-meta {
    display: none;
  }
  .lang-title {
    font-size: 2rem;
    line-height: 1.25;
    font-weight: 500;
    margin: 0 0 0.5rem;
  }
  .lang-meta {
    font-size: 0.9rem;
    opacity: 0.7;
    margin: 0 0 1.5rem;
  }
  .lang-zh {
    display: none;
  }
  html[data-lang='zh'] .lang-en {
    display: none;
  }
  html[data-lang='zh'] .lang-zh {
    display: block;
  }
</style>
<script>
  (function () {
    var KEY = 'surgview-post-lang';
    function apply(lang) {
      document.documentElement.setAttribute('data-lang', lang);
      document.querySelectorAll('.lang-btn').forEach(function (btn) {
        btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
      });
      try {
        localStorage.setItem(KEY, lang);
      } catch (e) {}
    }
    var saved = 'en';
    try {
      saved = localStorage.getItem(KEY) || 'en';
    } catch (e) {}
    apply(saved === 'zh' ? 'zh' : 'en');
    document.querySelectorAll('.lang-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        apply(btn.getAttribute('data-lang'));
      });
    });
  })();
</script>
